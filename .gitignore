# Environments & Secrets
.env
.env.*
*.local

# Frontend (React / Vite / Node)
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*

# Backend (Python / FastAPI / ML)
backend/venv/
backend/.venv/
backend/__pycache__/
