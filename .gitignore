# Datasets (ignore large raw/processed data files, keep docs/placeholders)
datasets/raw/*
datasets/processed/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
*.csv
*.parquet
*.xlsx
*.zip

# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
